# Copiar a .env.development.local (gitignored) para desarrollo local. En Coolify estas variables se cargan en el recurso.

# Base de datos (local: docker compose up -d). En Coolify la arma el compose con SERVICE_PASSWORD_POSTGRES.
DATABASE_URL=postgres://app:app@127.0.0.1:5432/app

# Better Auth: secreto largo y distinto por entorno (openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-64) y URL publica del entorno.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Archivos subidos (volumen). Local: carpeta ./storage; en el contenedor: /data/storage.
STORAGE_DIR=./storage

# URL publica del sitio (sitemap, robots, metadatos). Entra al BUILD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (G-XXXXXXXXXX). Vacio = sin analytics ni banner de cookies. Entra al BUILD.
NEXT_PUBLIC_GA_ID=
