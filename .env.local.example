# Copiar a .env.local (gitignored) y completar con las keys del proyecto
# de Supabase propio de TV Pro Academy (no reusar el de otro proyecto).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Analytics 4 — crear la propiedad en Google Analytics y pegar el
# Measurement ID acá (formato G-XXXXXXXXXX). Vacío = GA no se carga.
NEXT_PUBLIC_GA_ID=
